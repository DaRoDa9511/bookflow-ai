{
  "name": "bookflow-ai",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-business booking SaaS with a WhatsApp AI agent (React + Supabase + Claude).",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p supabase/functions/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@electric-sql/pglite": "^0.5.17",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "5.6",
    "typescript-eslint": "^8.73.0",
    "vitest": "^2.1.9",
    "zod": "^3.25.76"
  }
}
