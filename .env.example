# ── Web (apps/web/.env.local or Vercel) ──────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Public WhatsApp number used to build wa.me links (digits only, with country code)
VITE_WHATSAPP_NUMBER=15551234567
# Show demo-login shortcuts on /login (true for the public demo)
VITE_DEMO_MODE=true
# Password of the seeded demo accounts (see README). Demo-only.
VITE_DEMO_PASSWORD=

# ── Supabase Edge Function secrets (supabase secrets set ...) ────────
# Claude API (agent)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
CLAUDE_MODEL=claude-sonnet-5-5

# Messaging provider: "simulator" (default) or "whatsapp"
MESSAGING_PROVIDER=simulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# Emails (welcome / approval). Without a key emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=BookFlow AI <onboarding@resend.dev>

# Shared secret between pg_cron (Vault secret "cron_secret") and send-reminders
CRON_SECRET=

# Public URL of the web app, used in emails
APP_URL=https://bookflow-ai.vercel.app

# Provided automatically inside Supabase Edge Functions:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY

# ── Payments (postponed, see docs/DECISIONS.md) ──────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
